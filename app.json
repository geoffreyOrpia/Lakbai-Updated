{
  "expo": {
    "name": "LakBai",
    "slug": "lakbaylokal",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/lakbai-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF8F2",
        "foregroundImage": "./assets/lakbai-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ywach.lakbaylokal"
    },
    "web": {
      "favicon": "./assets/lakbai-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LakBai to use your location to find nearby saved places and support offline trail guidance."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF8F2",
          "image": "./assets/lakbai-mark.png"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "98a01ab0-c3ce-4f92-ab28-5a280aaa008c"
      }
    }
  }
}
